# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored; this example file is safe to commit.
#
# PowerShell:  Copy-Item .env.example .env
# Git Bash:    cp .env.example .env

# auto | ai | smart | rules
AIRWIZE_ADVISOR=auto

# OpenAI-compatible chat-completions service.
# Leave empty to keep the deterministic Smart plan.
AIRWIZE_AI_API_KEY=sk-your-key-here
AIRWIZE_AI_BASE_URL=https://api.openai.com/v1
AIRWIZE_AI_MODEL=gpt-4o-mini
AIRWIZE_AI_TIMEOUT=8
AIRWIZE_AI_CACHE_SECONDS=300

# Optional: point Flask at a scraper on another address.
# AIRWIZE_SCRAPER_URL=http://localhost:8080
# AIRWIZE_WEBSOCKET_URL=ws://localhost:8080/ws/readings

# Optional: synthetic solar / recommendation thresholds.
# AIRWIZE_SOLAR_SITE_NAME=demo-laguna-site
# AIRWIZE_SOLAR_PEAK_KW=5.0
# AIRWIZE_PM25_HIGH=35
# AIRWIZE_PM25_CRITICAL=75
